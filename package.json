{
  "name": "nextjs-resume",
  "version": "8.2.0",
  "keywords": [
    "generator",
    "nextjs",
    "pdf",
    "resume",
    "tailwind"
  ],
  "homepage": "https://github.com/colinhemphill/nextjs-resume",
  "license": "MIT",
  "author": {
    "name": "Colin Hemphill",
    "email": "colin@colinhemphill.com",
    "url": "https://colinhemphill.com"
  },
  "type": "module",
  "scripts": {
    "build": "contentlayer2 build && next build",
    "build:content": "contentlayer2 build",
    "dev": "run-p dev:*",
    "dev:contentlayer": "contentlayer2 dev",
    "dev:next": "next dev --turbopack",
    "format": "oxfmt",
    "knip": "knip-bun --fix --allow-remove-files",
    "lint": "oxlint --fix",
    "start": "next start",
    "sync": "syncpack fix-mismatches",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:update": "bun test --update-snapshots",
    "test:watch": "bun test --watch",
    "types": "tsc -p tsconfig.json --noEmit",
    "update": "syncpack update --interactive",
    "yeet": "bunx rimraf bun.lockb && bunx rimraf **/{dist,node_modules,.turbo,.next,.vercel,.netlify,__snapshots__}/ --glob && bunx rimraf **/tsconfig.tsbuildinfo --glob"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@icons-pack/react-simple-icons": "13.13.0",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@react-pdf/renderer": "4.9.0",
    "@strum/colors": "0.1.8",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "contentlayer2": "0.5.8",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-unicorn": "72.0.0",
    "next": "16.2.12",
    "next-contentlayer2": "0.5.8",
    "next-themes": "0.4.6",
    "npm-run-all2": "9.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf-html": "2.1.5",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "bun-types": "1.3.14",
    "knip": "6.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "postcss": "8.5.25",
    "syncpack": "15.3.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
